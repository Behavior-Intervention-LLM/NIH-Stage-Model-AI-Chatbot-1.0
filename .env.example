# ── LLM Provider ─────────────────────────────────────────────────────────────
# Options: openai | anthropic | ollama | groq
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Anthropic (optional) ──────────────────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ── Ollama — local inference (optional) ───────────────────────────────────────
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen2.5:3b-instruct
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# ── Groq — free hosted inference (optional) ───────────────────────────────────
# LLM_PROVIDER=groq
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile

# ── App ───────────────────────────────────────────────────────────────────────
DEBUG=false

# ── AWS S3 — cloud storage for data/ (optional) ───────────────────────────────
# When set, the container syncs s3://<S3_BUCKET_NAME>/<S3_DATA_PREFIX> → data/
# at startup, so documents and the vector store are pulled from S3 automatically.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# S3_BUCKET_NAME=my-nih-chatbot-bucket
# S3_DATA_PREFIX=data/
